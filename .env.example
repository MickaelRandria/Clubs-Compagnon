# Chaîne de connexion Neon (Dashboard Neon → Connect → "Pooled connection").
# Copie ce fichier en .env.local et remplace la valeur.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Génération des assets uniquement côté script Node (jamais de préfixe VITE_).
OPENAI_API_KEY=""

# Lecture du staff (rapport tactique FC 27) — Mistral, console.mistral.ai → API Keys.
# Absente : le rapport déterministe s'affiche seul, sans erreur ni bandeau. La clé reste
# côté serveur : jamais de préfixe VITE_, sinon elle partirait dans le bundle du navigateur.
MISTRAL_API_KEY=""
# Modèle utilisé pour cette analyse. Vide = ministral-14b-latest (palier gratuit).
# `npm run staff:check` liste les modèles que ta clé expose réellement.
MISTRAL_MODEL=""
